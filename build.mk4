-- make4ht build file for Book of Swarm HTML conversion
-- Usage: make4ht -c book.cfg -e build.mk4 main.tex "html5,mathjax"

-- Build sequence with glossary support
-- Run htlatex first pass
Make:htlatex()

-- Run makeglossaries for glossary generation
Make:match("glo$", function(filename)
  -- Run makeglossaries
  local basename = filename:gsub("%.glo$", "")
  os.execute("makeglossaries " .. basename)
  return true
end)

-- Run makeindex for index generation
Make:makeindex()

-- Run htlatex again to incorporate glossary/index
Make:htlatex()
Make:htlatex()

-- Post-process HTML files to clean up
Make:match("html$", function(filename)
  local f = io.open(filename, "r")
  if not f then return true end
  local content = f:read("*all")
  f:close()

  -- Remove any residual status markers
  content = content:gsub('<span class="statusgreen">[^<]*</span>', '')
  content = content:gsub('<span class="statusorange">[^<]*</span>', '')
  content = content:gsub('<span class="statusred">[^<]*</span>', '')
  content = content:gsub('<span class="statusyellow">[^<]*</span>', '')

  -- Clean up excessive whitespace
  content = content:gsub('\n%s*\n%s*\n', '\n\n')

  -- Add theme-toggle.js script before </body>
  content = content:gsub('</body>', '<script src="theme-toggle.js"></script></body>')

  local f = io.open(filename, "w")
  f:write(content)
  f:close()
  return true
end)
